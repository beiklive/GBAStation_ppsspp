+#ifdef __SWITCH__
+static unsigned int ppsspp_switch_if_nametoindex(const char *ifname)
+{
+	char *endptr;
+	unsigned long ifindex;
+	int fd;
+	struct ifreq ifr;
+
+	if (ifname == NULL || ifname[0] == '\0')
+		return 0;
+
+	ifindex = strtoul(ifname, &endptr, 10);
+	if (endptr != ifname && *endptr == '\0') {
+		if ((unsigned int)ifindex == ifindex)
+			return (unsigned int)ifindex;
+		return 0;
+	}
+
+	fd = socket(AF_INET, SOCK_DGRAM, 0);
+	if (fd < 0)
+		return 0;
+
+	memset(&ifr, 0, sizeof(ifr));
+	strncpy(ifr.ifr_name, ifname, IFNAMSIZ);
+	ifr.ifr_name[IFNAMSIZ - 1] = '\0';
+	if (ioctl(fd, SIOCGIFINDEX, &ifr) < 0) {
+		close(fd);
+		return 0;
+	}
+
+	close(fd);
+	return (unsigned int)ifr.ifr_index;
+}
+#define if_nametoindex ppsspp_switch_if_nametoindex
+#endif
